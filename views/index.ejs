<%- include('partials/nav') %>
<link rel="stylesheet" href="/style.css">
<main class="container">
  <h1>Our Products</h1>
  <div class="grid">
    <% products.forEach(p => { %>
      <div class="card">
        <img src="<%= p.image %>" alt="<%= p.name %>">
        <h3><%= p.name %></h3>
        <p class="price">₹<%= p.price %></p>
        <a href="/product/<%= p.id %>" class="btn">View Details</a>
      </div>
    <% }) %>
  </div>
</main>
